# Copy to the staging service's private environment configuration.
# Never commit real credentials or replace these placeholders in Git.
FUNERAL_SMART_ENV=staging
NODE_ENV=production
PORT=10000

MARIADB_HOST=REPLACE_WITH_STAGING_DB_HOST
MARIADB_PORT=3306
MARIADB_USER=REPLACE_WITH_STAGING_DB_USER
MARIADB_PASSWORD=REPLACE_WITH_STAGING_DB_PASSWORD
MARIADB_DATABASE=REPLACE_WITH_STAGING_DATABASE_NAME
MARIADB_STAGING_DATABASE=REPLACE_WITH_STAGING_DATABASE_NAME
MARIADB_CONNECTION_LIMIT=5

PUBLIC_APP_URL=https://REPLACE_WITH_STAGING_APP_HOST
# No mail transport is configured by the standalone staging server.
